{
  "name": "ecommerce-app",
  "version": "1.0.0",
  "description": "ECommerce Web Application with MVC Architecture",
  "main": "server.js",
  "scripts": {
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose --forceExit",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seedDatabase.js",
    "postinstall": "npx prisma generate"
  },
  "keywords": [
    "ecommerce",
    "express",
    "mvc",
    "jest"
  ],
  "author": "WAD03_RTR",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "services/**/*.js",
      "repositories/**/*.js",
      "controllers/**/*.js"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).js"
    ],
    "clearMocks": true,
    "resetMocks": true,
    "restoreMocks": true
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "express": "^5.1.0",
    "save-dev": "^0.0.1-security"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4"
  }
}
