{
  "name": "ecommerce-app",
  "version": "1.0.0",
  "description": "ECommerce Web Application with MVC Architecture",
  "main": "server.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seedDatabase.js"
  },
  "keywords": ["ecommerce", "express", "mvc", "mongodb", "jest"],
  "author": "WAD03_RTR",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "services/**/*.js",
      "repositories/**/*.js",
      "controllers/**/*.js"
    ],
    "testMatch": [
      "**/Testing/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/Testing/setup.js"
    ],
    "clearMocks": true,
    "resetMocks": true,
    "restoreMocks": true
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
